{% extends "template.njk" %}
{% from "macros/common-components.njk" import goBack %}

{% block pageTitle %}
  {{ title }}
{% endblock %}

{% block beforeContent %}
  {{ super() }}
  {{ goBack(text = backButton, cspNonce = cspNonce) }}
{% endblock %}

{% block content %}
<div class="parent-box">
  <h1 class="govuk-heading-l">{{ header }}</h1>

  <div id="section1">
    <h2 class="govuk-heading-m">{{ section1.heading }}</h2>
    <p class="govuk-body">{{ section1.text1Prefix }}
      <a href="{{ section1.link.href }}">{{ section1.link.text }}</a>{{ section1.text1Suffix }}
    </p>
    <p class="govuk-body">{{ section1.text2 }}</p>
  </div>

  <div id="section2">
    <h2 class="govuk-heading-m">{{ section2.heading }}</h2>
    <p class="govuk-body">{{ section2.text1 }}</p>
    <ol class="govuk-list govuk-list--number" type="I" style="list-style-type: upper-roman;">
      {% for item in section2.list1 %}
        <li>{{ item }}</li>
      {% endfor %}
    </ol>
    <p class="govuk-body">{{ section2.text2 }}</p>
    <ol class="govuk-list govuk-list--number" type="I" style="list-style-type: upper-roman;">
      {% for item in section2.list2 %}
        <li>{{ item }}</li>
      {% endfor %}
    </ol>
    <p class="govuk-body">{{ section2.text3 }}</p>
  </div>

  <div id="section3">
    <h2 class="govuk-heading-m">{{ section3.heading }}</h2>
    <p class="govuk-body">{{ section3.text1 }}</p>
    <h3 class="govuk-heading-s">{{ section3.section31.heading }}</h3>
    <p class="govuk-body">{{ section3.section31.text }}</p>
    <h3 class="govuk-heading-s">{{ section3.section32.heading }}</h3>
    <p class="govuk-body">{{ section3.section32.text1 }}</p>
    <ul class="govuk-list govuk-list--bullet">
      {% for item in section3.section32.list %}
        <li>{{ item }}</li>
      {% endfor %}
    </ul>
  </div>

  <div id="section4">
    <h2 class="govuk-heading-m">{{ section4.heading }}</h2>

    <h3 class="govuk-heading-s">{{ section4.section41.heading }}</h3>
    <p class="govuk-body">{{ section4.section41.text1 }}</p>
    <p class="govuk-body">{{ section4.section41.text2 }}</p>
    <ul class="govuk-list govuk-list--bullet">
      {% for item in section4.section41.list %}
        <li>{{ item }}</li>
      {% endfor %}
    </ul>
    <p class="govuk-body">{{ section4.section41.text3Prefix }}
      "<a href="{{ section4.section41.link.href }}">{{ section4.section41.link.text }}</a>"
      {{ section4.section41.text3Suffix }}
    </p>

    <h3 class="govuk-heading-s">{{ section4.section42.heading }}</h3>
    <p class="govuk-body">{{ section4.section42.text1 }}</p>
    <p class="govuk-body">{{ section4.section42.text2 }}</p>
    <ul class="govuk-list govuk-list--bullet">
      {% for item in section4.section42.list %}
        <li>{{ item }}</li>
      {% endfor %}
    </ul>

    <h3 class="govuk-heading-s">{{ section4.section43.heading }}</h3>
    <p class="govuk-body">{{ section4.section43.text1 }}</p>
    <p class="govuk-body">{{ section4.section43.quote }}</p>

    <h3 class="govuk-heading-s">{{ section4.section44.heading }}</h3>
    <p class="govuk-body">{{ section4.section44.text1 }}</p>
    <ul class="govuk-list govuk-list--bullet">
      {% for item in section4.section44.list %}
        <li>{{ item }}</li>
      {% endfor %}
    </ul>
  </div>

  <div id="section5">
    <h2 class="govuk-heading-m">{{ section5.heading }}</h2>

    <h3 class="govuk-heading-s">{{ section5.section51.heading }}</h3>
    <p class="govuk-body">{{ section5.section51.text1 }}</p>
    <p class="govuk-body">{{ section5.section51.text2 }}</p>
    <ul class="govuk-list govuk-list--bullet">
      {% for item in section5.section51.list %}
        <li>{{ item }}</li>
      {% endfor %}
    </ul>
    <p class="govuk-body">{{ section5.section51.text3 }}</p>

    <h3 class="govuk-heading-s">{{ section5.section52.heading }}</h3>
    <p class="govuk-body">{{ section5.section52.text1 }}</p>
    <ul class="govuk-list govuk-list--bullet">
      {% for item in section5.section52.list %}
        <li>{{ item }}</li>
      {% endfor %}
    </ul>
    <p class="govuk-body">{{ section5.section52.text2 }}</p>
    <p class="govuk-body">{{ section5.section52.text3 }}
      <a href="{{ section5.section52.link.href }}" target="_blank">{{ section5.section52.link.text }}</a>.
    </p>
  </div>

  <div id="section6">
    <h2 class="govuk-heading-m">{{ section6.heading }}</h2>

    <h3 class="govuk-heading-s">{{ section6.section61.heading }}</h3>
    <p class="govuk-body">{{ section6.section61.text1 }}</p>
    <ul class="govuk-list govuk-list--bullet">
      {% for item in section6.section61.linkedList %}
        <li>{{ item.prefix }}
          <a href="{{ item.link.href }}">{{ item.link.text }}</a>{{ item.suffix }}
        </li>
      {% endfor %}
      {% for item in section6.section61.list %}
        <li>{{ item }}</li>
      {% endfor %}
    </ul>
    <p class="govuk-body">{{ section6.section61.text2 }}</p>

    <h3 class="govuk-heading-s">{{ section6.section62.heading }}</h3>
    <p class="govuk-body">{{ section6.section62.text1 }}</p>
    <ul class="govuk-list govuk-list--bullet">
      {% for item in section6.section62.list %}
        <li>{{ item }}</li>
      {% endfor %}
    </ul>

    <h3 class="govuk-heading-s">{{ section6.section63.heading }}</h3>
    <p class="govuk-body">{{ section6.section63.text1 }}</p>
    <ul class="govuk-list govuk-list--bullet">
      {% for item in section6.section63.list %}
        <li>{{ item }}</li>
      {% endfor %}
    </ul>
  </div>

  <div id="section7">
    <h2 class="govuk-heading-m">{{ section7.heading }}</h2>
    {% for item in section7.text %}
      <p class="govuk-body">{{ item }}</p>
    {% endfor %}
  </div>

  <div id="section8">
    <h2 class="govuk-heading-m">{{ section8.heading }}</h2>
    {% for item in section8.text %}
      <p class="govuk-body">{{ item }}</p>
    {% endfor %}
  </div>

  <div id="section9">
    <h2 class="govuk-heading-m">{{ section9.heading }}</h2>
    {% for item in section9.text %}
      <p class="govuk-body">{{ item }}</p>
    {% endfor %}
  </div>

  <div id="section10">
    <h2 class="govuk-heading-m">{{ section10.heading }}</h2>
    {% for item in section10.text %}
      <p class="govuk-body">{{ item }}</p>
    {% endfor %}
    {% for item in section10.address %}
      <p class="govuk-body govuk-!-margin-bottom-0">{{ item }}</p>
    {% endfor %}
  </div>
  <br>
  {{ super() }}
</div>
{% endblock %}
