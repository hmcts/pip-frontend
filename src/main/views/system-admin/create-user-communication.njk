{% from "../macros/common-components.njk" import goBack, submitButton, backButtonHistory %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}

{% extends "../template.njk" %}
{% block pageTitle %}
    {{ title }}
{% endblock %}
{% block beforeContent %}
    {{ super() }}
    {{ goBack(cspNonce = cspNonce) }}
{% endblock %}
{% block content %}
    {% if formErrors %}
        {% set errorList = [] %}
        {% if formErrors.bannerMessageError %}
            {% set errorList = (errorList.push({text: bannerMessageError, href: "#userCommunication"}), errorList) %}
        {% endif %}
        {% if formErrors.typeOfCommunicationError %}
            {% set errorList = (errorList.push({text: typeOfCommunicationError, href: "#userCommunication"}), errorList) %}
        {% endif %}
        {{ govukErrorSummary({
            titleText: errorTitle,
            errorList: errorList
        }) }}
    {% endif %}

    {% set bannerMessageErrorMessage = {text: bannerMessageError} if formErrors.bannerMessageError else '' %}
    {% set bannerMessageWelshErrorMessage = {text: bannerMessageWelshError} if formErrors.bannerMessageWelshError else '' %}
    {% set typeOfCommunicationErrorMessage = {text: typeOfCommunicationError} if formErrors.typeOfCommunicationError else '' %}
    {% set bannerMessageInput = govukInput({
        classes: 'govuk-!-width-two-thirds',
        id: "bannerMessage",
        name: "bannerMessage",
        value: formData.bannerMessage,
        label: {
            text: bannerMessageLabel
        },
        errorMessage: bannerMessageErrorMessage
    }) %}
    {% set bannerMessageWelshInput = govukInput({
        classes: 'govuk-!-width-two-thirds',
        id: "bannerMessageWelsh",
        name: "bannerMessageWelsh",
        value: formData.bannerMessageWelsh,
        label: {
            text: bannerMessageWelshLabel
        },
        errorMessage: bannerMessageWelshErrorMessage
    }) %}
    {% set typeOfCommunicationInput = govukRadios({
        idPrefix: "typeOfCommunication",
        name: "typeOfCommunication",
        value: formData.typeOfCommunication,
        fieldset: {
            legend: {
                text: typeOfCommunicationLabel
            }
        },
        items: [
            {
                value: "allUsers",
                text: "All Users",
                href: "/create-user-communication-summary"
            },
            {
                value: "selectedJurisdiction",
                text: "Selected Jurisdiction",
                href: "/create-user-communication?type=selectedJurisdiction"
            },
            {
                value: "selectedUserRole",
                text: "Selected User Role",
                href: "/create-user-communication?type=selectedUserRole"
            },
            {
                value: "selectedUserProvenance",
                text: "Selected User Provenance",
                href: "/create-user-communication?type=selectedUserProvenance"
            },
            {
                value: "selectedVenue",
                text: "Selected Venue",
                href: "/create-user-communication?type=selectedVenue"
            }
        ],
        errorMessage: typeOfCommunicationErrorMessage
    }) %}

    <h1 class="govuk-heading-l">{{ heading }}</h1>
    <form method="post" novalidate>
        {{ bannerMessageInput }}
        {{ bannerMessageWelshInput }}
        {{ typeOfCommunicationInput }}
        {{ submitButton() }}
        <a class="govuk-link" id='cancel-create-communication' href='/user-communication-management'>{{ cancelButton }}</a>
    </form>

{% endblock %}
{% block bodyEnd %}
    {{ super() }}
    {{ backButtonHistory(cspNonce) }}
{% endblock %}
