{% extends "../template.njk" %}
{% from "../macros/common-components.njk" import goBack, communicationBanner %}

{% block pageTitle %}
  {{ title }}
{% endblock %}
{% block beforeContent %}
  {{ super() }}
  {{ goBack(cspNonce=cspNonce) }}
{% endblock %}
{% block pageBanner %}
    {% set html %}
        {% if userCommunications.userProvenanceType | length %}
            {% for communication in userCommunications.userProvenanceType %}
                {% if user.userProvenance in communication.provenances %}
                    <p class="govuk-body">{{ communication.welshMessage if lng==='cy' else communication.message }}</p>
                {% endif %}
            {% endfor %}
        {% endif %}

        {% if userCommunications.userRoleType | length %}
            {% for communication in userCommunications.userRoleType %}
                {% if user.roles in communication.roles %}
                    <p class="govuk-body">{{ communication.welshMessage if lng==='cy' else communication.message }}</p>
                {% endif %}
            {% endfor %}
        {% endif %}
    {% endset %}

    {{ communicationBanner(lng, allUsersComms, html) }}
{% endblock %}
{% block content %}
  <div class="parent-box">
    <div class="govuk-grid-row parent-box">
      <h1 class="govuk-heading-l">{{ heading }}</h1>
    </div>
    <div class="cards-wrapper">
      {% for tile in tiles %}
        <div class="govuk-!-margin-top-2 govuk-!-margin-bottom-2 admin-card">
          <div class="account-card govuk-!-margin-left-2 govuk-!-margin-right-2">
            <p>
              <a href="{{ tile.link }}"
                 class="govuk-link govuk-body govuk-!-font-weight-bold"
                 id="card-{{ tile.link }}"
              >{{ tile.title }}</a>
            </p>
            <p class="govuk-body">{{ tile.description }}</p>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
{% endblock %}

{% block bodyEnd %}
  {{ super() }}
{% endblock %}
