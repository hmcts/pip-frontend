{% extends "template.njk" %}
{% from "./macros/common-components.njk" import goBack, communicationBanner %}

{% block pageTitle %}
    {{ title }}
{% endblock %}
{% block beforeContent %}
    {{ super() }}
    {{ goBack(text = backButton, cspNonce = cspNonce) }}
{% endblock %}
{% block pageBanner %}
    {% set pageHtml %}
        {% if showVerifiedBanner %}
            <p class="govuk-notification-banner__heading">{{ bannerText }}</p>
        {% endif %}
    {% endset %}
    {% set commHtml %}
        {% if userCommunications.userProvenanceType | length %}
            {% for communication in userCommunications.userProvenanceType %}
                {% if user.userProvenance in communication.provenances %}
                    <p class="govuk-body">{{ communication.welshMessage if lng === 'cy' else communication.message | safe }}</p>
                {% endif %}
            {% endfor %}
        {% endif %}

        {% if userCommunications.userRoleType | length %}
            {% for communication in userCommunications.userRoleType %}
                {% if user.roles in communication.roles %}
                    <p class="govuk-body">{{ communication.welshMessage if lng === 'cy' else communication.message | safe }}</p>
                {% endif %}
            {% endfor %}
        {% endif %}
    {% endset %}

    {{ communicationBanner(lng, allUsersComms, commHtml, pageHtml) }}
{% endblock %}
{% block content %}
    <div class="parent-box">
    <div class="govuk-grid-row">
        <h1 class="govuk-heading-l">{{ header }}</h1>
    </div>
    <div class="cards-wrapper">
        {% for card in cards %}
            <div class="govuk-!-margin-top-2 govuk-!-margin-bottom-2">
                <div class="account-card govuk-!-margin-left-2 govuk-!-margin-right-2">
                    <p>
                        <a href="{{ card.link }}"
                           class="govuk-link govuk-body govuk-!-font-weight-bold" id="card-{{ card.link }}">{{ card.title }}</a>
                    </p>
                    <p class="govuk-body">{{ card.description }}</p>
                </div>
            </div>
        {% endfor %}
    </div>
  {{ super() }}
  </div>
{% endblock %}

{% block bodyEnd %}
  {{ super() }}
{% endblock %}
